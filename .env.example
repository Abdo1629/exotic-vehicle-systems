# Server-only variables — configure in local .env.local or deployment secret settings.
# Never commit real values and never prefix secrets with NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
EVS_INGEST_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Internal-only temporary read gate. Do not enable on a public deployment; this bypasses user/team authorization.
# EVS_ALLOW_UNAUTHENTICATED_TELEMETRY_READ=true

# Mobile app: set only the public base URL, never secrets.
# Configure this after secure sign-in and team/vehicle read authorization are enabled.
EXPO_PUBLIC_EVS_API_URL=https://your-secured-evs-domain.example
