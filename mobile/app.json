{
  "expo": {
    "name": "Exotic Racing",
    "slug": "exotic-racing-mobile",
    "scheme": "exoticracing",
    "version": "0.2.0",
    "icon": "../public/logo.jpeg",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iaet.exoticracing"
    },
    "android": {
      "package": "com.iaet.exoticracing",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "../public/logo.jpeg",
        "backgroundColor": "#090A0B"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "androidStatusBar": {
      "backgroundColor": "#090A0B",
      "barStyle": "light-content"
    }
  }
}
